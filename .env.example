# Never commit this file after adding secrets. Keep APP_SECRET unchanged: it encrypts saved keys/tokens.
APP_SECRET=replace-with-generated-secret
APP_PASSWORD=replace-with-a-long-password
BASE_URL=http://localhost:8000
DATA_DIR=./data
DEMO_MODE=false
# Web application OAuth client; enable Classroom and Drive APIs in its Google project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: can also be saved through the authenticated dashboard.
GEMINI_API_KEY=
# Optional email notifications, STARTTLS on port 587. No email is sent unless configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL=
# Public deployment only; Caddy requires a hostname whose DNS points to your VM.
DOMAIN=desk.example.com
ACME_EMAIL=you@example.com
